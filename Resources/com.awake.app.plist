<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.awake.app</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/Awake.app/Contents/MacOS/Awake</string>
		<string>--menubar</string>
	</array>
	<!-- Attributes this job to Awake in Login Items & Extensions, so it is
	     listed under the app's name and icon rather than as a bare entry. -->
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.awake.app</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- Restart on crash, but respect an explicit Quit from the menu. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
</dict>
</plist>
